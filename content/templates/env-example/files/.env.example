# Copy this file to .env and fill in the values: cp .env.example .env
# Commit .env.example. Never commit .env.

# --- App ---
# development, test or production
NODE_ENV=development
# The public URL of the app, without a trailing slash
APP_URL=http://localhost:3000
PORT=3000

# --- Database ---
# Matches the Postgres service in docker-compose.yml
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- Auth ---
# A random string of at least 32 characters: openssl rand -base64 32
AUTH_SECRET=
# OAuth app from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email ---
# Leave empty in development to print emails to the console
SMTP_URL=
EMAIL_FROM="Acme <hello@example.com>"

# --- Optional ---
# Error reporting. Leave empty to turn it off.
SENTRY_DSN=
LOG_LEVEL=info
