# Example for a Node app. Keep only the variables your app reads.
# On a fresh clone, copy this file to .env and fill the required values.
# Commit this file and keep .env out of version control.

# --- App ---
# development, test or production
NODE_ENV=development
# The public URL of the app, without a trailing slash
APP_URL=http://localhost:3000
PORT=3000

# --- Database ---
# Local defaults for the companion Postgres compose.yaml
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app

# --- Auth ---
# Required. Generate a local value with: openssl rand -hex 32
AUTH_SECRET=
# Optional. Set both values if your app enables GitHub OAuth.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email ---
# Optional. Configure only if your app sends email through SMTP.
SMTP_URL=
EMAIL_FROM="Acme <hello@example.com>"

# --- Optional ---
# Optional error-reporting endpoint. Match your app's handling of empty values.
SENTRY_DSN=
LOG_LEVEL=info
