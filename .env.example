# Where "Sign in", "Create a paste" etc. point. Defaults to https://app.sniptide.com; for local
# development, point it at a running app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Same value as the app's SHARE_PROXY_SECRET. When set, every proxied request sends the visitor
# address and this secret so the app can trust them. Leave unset and neither header is sent.
# SHARE_PROXY_SECRET=

# Incoming header that carries the visitor address. Defaults to the last X-Forwarded-For hop.
# If that header is missing, no address is forwarded.
# CLIENT_IP_HEADER=

# PostHog project key (phc_...). Leave unset and no analytics or cookie banner load. Events are
# cookieless until the visitor accepts the banner, and tagged surface=marketing; the app uses the
# same project with surface=app.
# NEXT_PUBLIC_POSTHOG_KEY=

# PostHog region. Defaults to https://eu.i.posthog.com; use https://us.i.posthog.com for US cloud.
# NEXT_PUBLIC_POSTHOG_HOST=

# GitHub token for the changelog, which reads the app repo's releases and refreshes hourly. Optional:
# without it GitHub allows 60 requests an hour per IP address, which a shared host can use up.
# Any token works; it needs no scopes because the repo is public.
# GITHUB_TOKEN=

# Public Better Stack status page, such as https://status.sniptide.com. The footer's status line
# shows its overall state and links to it. Leave unset and the line checks the app's /api/health.
# STATUS_PAGE_URL=
