# Where "Sign in", "Create a paste" etc. point. Defaults to https://app.sniptide.com; for local
# development, point it at a running app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Same value as the app's SHARE_PROXY_SECRET. When set, every proxied request sends the visitor
# address and this secret so the app can trust them. Leave unset and neither header is sent.
# SHARE_PROXY_SECRET=

# Incoming header that carries the visitor address. Defaults to the last X-Forwarded-For hop.
# If that header is missing, no address is forwarded.
# CLIENT_IP_HEADER=
