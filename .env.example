# Where "Sign in", "Create a paste" etc. point. Defaults to https://app.sniptide.com; for local
# development, point it at a running app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where "Try the demo" points: /demo on an app instance running with DEMO_MODE=true.
# Defaults to https://demo.sniptide.com/demo.
# NEXT_PUBLIC_DEMO_URL=

# Same value as the app's SHARE_PROXY_SECRET. When set, every proxied request sends the visitor
# address and this secret so the app can trust them. Leave unset and neither header is sent.
# SHARE_PROXY_SECRET=

# Incoming header that carries the visitor address. Defaults to the last X-Forwarded-For hop.
# If that header is missing, no address is forwarded.
# CLIENT_IP_HEADER=

# PostHog project key (phc_...). Leave unset and no analytics load. Events are cookieless and
# tagged surface=marketing; the app uses the same project with surface=app.
# NEXT_PUBLIC_POSTHOG_KEY=

# PostHog region. Defaults to https://eu.i.posthog.com; use https://us.i.posthog.com for US cloud.
# NEXT_PUBLIC_POSTHOG_HOST=
